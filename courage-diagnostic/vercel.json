{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "lieinventory.thecourageeconomy.net" }],
      "destination": "/inventory.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "diagnostic.bellomoleadership.com" }],
      "destination": "https://diagnostic.thecourageeconomy.net/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "diagnostic.bellomoleadership.com" }],
      "destination": "https://diagnostic.thecourageeconomy.net/:path*",
      "permanent": true
    }
  ]
}
